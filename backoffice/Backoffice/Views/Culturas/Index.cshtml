@model IEnumerable<Domain.Entidades.Cadastros.Cultura.Cultura>

@{
    ViewData["Title"] = GetType().Name.Replace("Views_", "").Replace("_Index", "");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create">Adicionar Item</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AlvoBiologico)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AlvoBiologico)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdCultura">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.IdCultura">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.IdCultura">Deletar</a>
            </td>
        </tr>
}
    </tbody>
</table>
