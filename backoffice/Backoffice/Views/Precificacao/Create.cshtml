@model Domain.Entidades.Cadastros.Precificacao.Precificacao

@{
    ViewData["Title"] = GetType().Name.Replace("Views_", "").Replace("_Create", "");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Precificacao</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdEmpresa" class="control-label"></label>
                <select asp-for="IdEmpresa" class ="form-control" asp-items="ViewBag.IdEmpresa"></select>
            </div>
            <div class="form-group">
                <label asp-for="DistanciaPista" class="control-label"></label>
                <input asp-for="DistanciaPista" class="form-control" />
                <span asp-validation-for="DistanciaPista" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PrecoHA" class="control-label"></label>
                <input asp-for="PrecoHA" class="form-control" />
                <span asp-validation-for="PrecoHA" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar a Lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
